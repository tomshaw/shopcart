{
    "name": "tomshaw/shopcart",
    "description": "A modern easy to use Laravel shopping cart",
    "keywords": [
        "ecommerce",
        "shopping-cart",
        "shopcart",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Shaw",
            "email": "tomshaw@tomshaw.us",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "illuminate/events": "^11.0|^12.0",
        "illuminate/session": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "TomShaw\\ShopCart\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomShaw\\ShopCart\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "baseline": "vendor/bin/phpstan analyse --ansi --memory-limit=-1 --generate-baseline --allow-empty-baseline",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint --config pint.json"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomShaw\\ShopCart\\Providers\\ShopCartServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
